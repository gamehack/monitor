{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "compatibility_flags": [ "nodejs_compat" ]
}
